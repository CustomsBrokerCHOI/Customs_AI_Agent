# UNIPASS Open API 인증키 (관세청 전자통관시스템 → 연계신청)
# UNIPASS 는 서비스별로 별도 인증키(crkyCn) 를 발급한다.
# 공통 기본키(단일 서비스만 쓰는 경우):
UNIPASS_API_KEY=your_key_here

# 서비스별 키 (다수 서비스 사용 시 권장. 기본키보다 우선)
# 환경변수 이름은 UNIPASS_API_KEY_<서비스명 대문자>
UNIPASS_API_KEY_HSSGNQRY=your_key_here                   # HS 부호 조회
UNIPASS_API_KEY_TRRTQRY=your_key_here                    # 관세율 조회 (trrtQry/retrieveTrrt)
UNIPASS_API_KEY_STATSSGNQRY=your_key_here                # 통계부호내역조회
UNIPASS_API_KEY_CARGCSCLPRGSINFOQRY=your_key_here        # 화물통관진행정보조회
UNIPASS_API_KEY_TRIFFXRTINFOQRY=your_key_here            # 관세환율 (미신청 시 비워두기)

# 로그 레벨: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# --- FastAPI / DB (Phase 4-A 이후) ---
ENV=development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/customs

# --- JWT 인증 ---
JWT_SECRET=change-me-in-env-at-least-32-chars-random
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=1209600

# --- LLM ---
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here_for_embeddings
HUGGINGFACE_TOKEN=your_hf_token_for_bge_m3_ko_eval
# Gemini Grounded Search (물품명만/사진만 입력 시 웹 검색으로 description 보강).
# https://aistudio.google.com/app/apikey 에서 발급. 미설정 시 보강 엔드포인트는 503.
GEMINI_API_KEY=your_gemini_key_here

# --- 분류 엔진 튜닝 ---
TOP_K_CANDIDATES=30
TOP_N_VERIFIED=3
CLASSIFY_TIMEOUT_SECONDS=60
RATE_LIMIT_PER_DAY=100

# --- CORS (프런트 origin. 여러 개면 쉼표 구분) ---
CORS_ORIGINS=http://localhost:3000
