# UNIPASS Open API 인증키 (관세청 전자통관시스템 → 연계신청)
# UNIPASS 는 서비스별로 별도 인증키(crkyCn) 를 발급한다.
# 공통 기본키(단일 서비스만 쓰는 경우):
UNIPASS_API_KEY=your_key_here

# 서비스별 키 (다수 서비스 사용 시 권장. 기본키보다 우선)
# 환경변수 이름은 UNIPASS_API_KEY_<서비스명 대문자>
UNIPASS_API_KEY_HSSGNQRY=your_key_here                   # HS 부호 조회
UNIPASS_API_KEY_TRRTQRY=your_key_here                    # 관세율 조회 (trrtQry/retrieveTrrt)
UNIPASS_API_KEY_STATSSGNQRY=your_key_here                # 통계부호내역조회
UNIPASS_API_KEY_CARGCSCLPRGSINFOQRY=your_key_here        # 화물통관진행정보조회
UNIPASS_API_KEY_TRIFFXRTINFOQRY=your_key_here            # 관세환율 (미신청 시 비워두기)

# 로그 레벨: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
